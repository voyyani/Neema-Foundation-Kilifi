{
  "rewrites": [
    {
      "source": "/donate",
      "destination": "/donate/index.html"
    },
    {
      "source": "/volunteer",
      "destination": "/volunteer/index.html"
    },
    {
      "source": "/partner",
      "destination": "/partner/index.html"
    },
    {
      "source": "/sponsorship",
      "destination": "/sponsorship/index.html"
    },
    {
      "source": "/programs",
      "destination": "/programs/index.html"
    },
    {
      "source": "/media",
      "destination": "/media/index.html"
    },
    {
      "source": "/board",
      "destination": "/board/index.html"
    },
    {
      "source": "/bank-details",
      "destination": "/bank-details/index.html"
    },
    {
      "source": "/legacy-giving",
      "destination": "/legacy-giving/index.html"
    },
    {
      "source": "/maintenance",
      "destination": "/maintenance/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
